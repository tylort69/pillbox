pkgbase = pillbox-git
	pkgdesc = Material You bar, start menu and notification center for Hyprland, built with Quickshell
	pkgver = r0.0000000
	pkgrel = 1
	url = https://github.com/tylort69/pillbox
	install = pillbox.install
	arch = any
	license = MIT
	makedepends = git
	depends = quickshell
	depends = hyprland
	depends = ttf-firacode-nerd
	depends = python
	depends = pipewire
	depends = wireplumber
	depends = libnotify
	optdepends = fd: start menu file search
	optdepends = fzf: start menu fuzzy file ranking
	optdepends = ripgrep: start menu search inside files and logs
	optdepends = matugen: colours from your wallpaper
	optdepends = imagemagick: wallpaper picker thumbnails
	optdepends = hyprpaper: set wallpapers (swww, awww or swaybg also work)
	optdepends = pacman-contrib: updates panel (checkupdates)
	optdepends = hyprsunset: night light
	optdepends = bluez-utils: Bluetooth panel
	optdepends = iwd: Wi-Fi in the network panel
	optdepends = snapper: snapshots panel (btrfs)
	optdepends = nvidia-utils: NVIDIA GPU stats
	optdepends = sound-theme-freedesktop: timer alarm sound
	optdepends = pipewire-audio: timer alarm sound (pw-play)
	optdepends = hyprpolkitagent: restart buttons in the failed-services panel
	optdepends = btop: system stats button
	optdepends = nvtop: GPU stats button
	optdepends = wiremix: audio mixer button
	optdepends = pavucontrol: audio mixer button
	optdepends = wlogout: power menu
	optdepends = yazi: file manager button
	optdepends = wl-clipboard: copy addresses and clipboard history
	provides = pillbox
	conflicts = pillbox
	source = pillbox::git+https://github.com/tylort69/pillbox.git
	sha256sums = SKIP

pkgname = pillbox-git
